# ---- LLM (Groq, free tier) ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# ---- Hugging Face Inference API (embeddings, hosted, not local) ----
HF_API_TOKEN=your_hf_api_token
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- LangSmith ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=pdf-rag-agent

# ---- Lakera Guard (prompt injection) ----
LAKERA_API_KEY=your_lakera_api_key
LAKERA_API_URL=https://api.lakera.ai/v2/guard

# ---- NeMo Guardrails ----
NEMO_CONFIG_PATH=guardrails_config

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
MAX_MEMORY_TURNS=5
RETRIEVAL_TOP_K=5
RELEVANCE_SCORE_THRESHOLD=0.35
CHROMA_PERSIST_DIR=data/chroma
UPLOAD_DIR=data/uploads

# ---- MCP server (spawned over stdio) ----
MCP_SERVER_SCRIPT=mcp_server/server.py
